# Origem da API do BarberOS (sem /api). Obrigatória no build de produção.
VITE_API_BASE_URL=http://localhost:3000

# URL pública deste front (links compartilháveis da página da barbearia). Padrão: origem atual.
VITE_APP_URL=http://localhost:5173

# Client ID OAuth do Google (o mesmo GOOGLE_CLIENT_ID da API). Vazio = botões do Google ocultos.
VITE_GOOGLE_CLIENT_ID=

# Versão dos termos de uso/privacidade aceita no cadastro (igual a TERMS_VERSION da API).
VITE_TERMS_VERSION=2026-11

# SEC-17: origem do bucket de imagens só quando NÃO for https (ex.: bucket local). Em produção (R2 https) deixe vazio.
VITE_IMAGES_ORIGIN=
