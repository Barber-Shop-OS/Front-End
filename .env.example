# Base URL da API do BarberOS (backend).
# Em produção, altere apenas este valor, ex.:
# VITE_API_BASE_URL=https://api.meudominio.com
VITE_API_BASE_URL=http://localhost:3000

# Quando "true", o fluxo de autenticação usa mocks locais (não chama o backend).
VITE_USE_MOCK_AUTH=false

# Client ID do OAuth Google (habilita login/cadastro com Google).
VITE_GOOGLE_CLIENT_ID=

