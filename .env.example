# Base URL da API do BarberOS (backend), apenas a origem — o "/api" é adicionado pelo app.
# Obrigatória no build (npm run build falha sem ela). Em dev, sem valor, usa http://localhost:3000.
VITE_API_BASE_URL=http://localhost:3000

# Quando "true", o fluxo de autenticação usa mocks locais (só em dev; ignorado no build de produção).
VITE_USE_MOCK_AUTH=false

# Login/cadastro com Google: só ligue quando o backend tiver o endpoint de OAuth.
VITE_GOOGLE_AUTH_ENABLED=false
VITE_GOOGLE_CLIENT_ID=
